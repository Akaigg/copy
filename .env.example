# Chave da OpenAPI da GMGN (crie em https://gmgn.ai/ai)
GMGN_API_KEY=

# Chave privada de ASSINATURA da API (PEM Ed25519 ou RSA) — NÃO é a chave da carteira.
# Pode ser colada em uma linha com \n, ou use GMGN_PRIVATE_KEY_FILE apontando para o .pem
GMGN_PRIVATE_KEY=
GMGN_PRIVATE_KEY_FILE=

# Endereço da carteira Solana vinculada à API key (obrigatório no modo live)
GMGN_WALLET_ADDRESS=

# Notificações Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
